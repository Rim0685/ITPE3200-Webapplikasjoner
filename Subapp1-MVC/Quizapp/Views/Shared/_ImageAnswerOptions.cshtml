@*  This is a partial view for rendering image answer options in a quiz application. 
    It uses the QuestionViewModel to display the options and handle user selections.

    The HTML structure is based on the standard form structure form W3School (HTML form elements and radio buttons). 
    Found form: https://www.w3schools.com/html/html_form_elements.asp
    
    Custom development and adaption of the form structure to fit the quiz application requirements.*@

@model Quizapp.ViewModels.QuestionViewModel

<fieldset class="answer-group">
    <legend class="instruction-text">Choose an image option</legend>

    <div class="options-grid image-options">
        @* Runs through every available answeroption from the model *@

        @foreach (var option in Model.Options)
        {

            @* Check if the current option is selected *@
          bool isChecked = Model.SelectedOptionIds.Contains(option.Id);

            <label class="option-card image-option @(isChecked ? "selected" : "")" for="opt-img-@option.Id">

                @* Radio button for single selection *@

                <input type="radio" 
                       id="opt-img-@option.Id" 
                       name="Answers[@Model.QuestionIndex].SelectedAnswerOptionIds" 
                       value="@option.Id" 
                       checked="@isChecked" 
                       aria-checked="@isChecked.ToString().ToLower()" />
                
                <div class="image-wrapper">

                    @* Image display with alt-text fallback *@

                    <img src="@option.ImageUrl" alt="@(string.IsNullOrEmpty(option.Text) ? "Svaralternativ bilde" : option.Text)" loading="lazy" />

                    @* Selection badge for visual feedback *@

                    <div class="selection-badge" aria-hidden="true">
                        <span class="checkmark">✓</span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(option.Text))
                {
                    <span class="option-label">@option.Text</span>
                }
            </label>
        }
    </div>
</fieldset>