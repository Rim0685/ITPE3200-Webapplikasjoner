[HttpGet]
public IActionResult Create()
{
    return View();
}

[HttpPost]
public IActionResult Create(Item item)
{
    if (ModelState.IsValid)
    {
        _itemDbContext.Items.Add(item);
        _itemDbContext.SaveChanges();
        return RedirectToAction(nameof(Table));
    }

    return View(item);
}