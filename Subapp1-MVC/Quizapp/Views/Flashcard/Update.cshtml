@model Flashcard
@* Skjema for å endre et flashcard. Feltene fylles automatisk ut med kortets nåværende tekst. *@

<h1>Edit flashcard</h1>

<form asp-action="Update" method="post">
    @* Skjult felt som sender med kortets ID, så controlleren vet hvilket kort som skal oppdateres. *@
    <input type="hidden" asp-for="FlashcardId" />

    <div>
        <label asp-for="QuestionText">Question</label><br />
        <input asp-for="QuestionText" />
        <span asp-validation-for="QuestionText"></span>
    </div>

    <div>
        <label asp-for="AnswerText">Answer</label><br />
        <textarea asp-for="AnswerText"></textarea>
        <span asp-validation-for="AnswerText"></span>
    </div>

    <button type="submit">Save changes</button>
    <a asp-action="Index">Cancel</a>
</form>
