@model Quizapp.ViewModels.FlashcardViewModel

@* Form for editing a flashcard. *@
@{
    ViewData["Title"] = "Edit flashcard";
}

<h1>Edit <span class="highlight">flashcard</span></h1>

<form asp-action="Update" method="post" class="card">
    <div asp-validation-summary="ModelOnly"></div>

    @* Identifies the flashcard to update. Ownership is checked on the server. *@
    <input type="hidden" asp-for="FlashcardId" />

    <label asp-for="QuestionText"></label>
    <input asp-for="QuestionText" />
    <span asp-validation-for="QuestionText"></span>

    <label asp-for="AnswerText"></label>
    <textarea asp-for="AnswerText" rows="4"></textarea>
    <span asp-validation-for="AnswerText"></span>

    @* Allows the user to change or remove the associated deck. *@
    <label asp-for="DeckId"></label>
    <select asp-for="DeckId" asp-items="Model.Decks">
        <option value="">No deck</option>
    </select>
    <span asp-validation-for="DeckId"></span>

    <p>
        <button type="submit" class="btn btn-dark">Save changes</button>
        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}