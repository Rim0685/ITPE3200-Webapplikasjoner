@model IEnumerable<Quizapp.ViewModels.FlashcardViewModel>

@* Shows the user's flashcards and available actions. *@
@{
    ViewData["Title"] = "Flashcards";
}

<h1>Your <span class="highlight">flashcards</span></h1>

<p>
    <a asp-action="Create" class="btn btn-light">+ New flashcard</a>
    <a asp-controller="FlashcardDeck"
       asp-action="Index"
       class="btn btn-light">My decks</a>
    <a asp-action="Study" class="btn btn-dark">Study all</a>
</p>

@if (!Model.Any())
{
    <p class="muted">You have no flashcards yet. Create your first one!</p>
}

<div class="grid">
    @foreach (var card in Model)
    {
        <div class="card">
            @if (card.DeckId.HasValue)
            {
                <a asp-controller="FlashcardDeck"
                   asp-action="Details"
                   asp-route-id="@card.DeckId"
                   class="pill">@card.DeckName</a>
            }
            else
            {
                <span class="pill">No deck</span>
            }

            <h3>@card.QuestionText</h3>
            <p class="muted">@card.AnswerText</p>

            <a asp-action="Update"
               asp-route-id="@card.FlashcardId"
               class="btn btn-light">Edit</a>

            <a asp-action="Delete"
               asp-route-id="@card.FlashcardId"
               class="btn btn-danger">Delete</a>
        </div>
    }
</div>