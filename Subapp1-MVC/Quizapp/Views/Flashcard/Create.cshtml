@model Flashcard

@{
    ViewData["Title"] = "New flashcard";
}

<h1>New <span class="highlight">flashcard</span></h1>

<form asp-action="Create" method="post" class="card">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <label asp-for="QuestionText">Question</label>
    <input asp-for="QuestionText" />
    <span asp-validation-for="QuestionText" class="text-danger"></span>

    <label asp-for="AnswerText">Answer</label>
    <textarea asp-for="AnswerText" rows="4"></textarea>
    <span asp-validation-for="AnswerText" class="text-danger"></span>

    <p>
        <button type="submit" class="btn btn-dark">Save</button>
        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}