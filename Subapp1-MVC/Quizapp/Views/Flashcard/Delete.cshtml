@model Flashcard
@* Confirmation page before a flashcard is deleted. Shows the card so the user can see what will be deleted. *@
@{
    ViewData["Title"] = "Delete flashcard";
}

<h1>Delete flashcard?</h1>

<div class="card">
    <h3>@Model.QuestionText</h3>
    <p class="muted">@Model.AnswerText</p>

    @* Deleting uses POST (not a normal link), so cards cannot be deleted by accident.
       The hidden field sends the ID of the card to delete. *@
    <form asp-action="DeleteConfirmed" asp-route-id="@Model.FlashcardId" method="post">
        <input type="hidden" asp-for="FlashcardId" />
        <button type="submit" class="btn btn-danger">Yes, delete</button>
        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </form>
</div>
