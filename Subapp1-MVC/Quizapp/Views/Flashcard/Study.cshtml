@model Flashcard
@* Study mode: shows one card at a time with a hidden answer and previous/next buttons. *@
@{
    ViewData["Title"] = "Study";

    // Position and number of cards, sent from the controller through ViewBag.
    int index = ViewBag.Index;
    int total = ViewBag.Total;

    // Set when studying a single deck, so the links stay inside that deck.
    int? deckId = ViewBag.DeckId;
}

@* index starts at 0, so 1 is added to show "Card 1" instead of "Card 0". *@
<p class="muted center">Card @(index + 1) of @total</p>

<div class="card center">
    <span class="pill">Question</span>
    <h2 class="study-question">@Model.QuestionText</h2>

    @* <details> hides the answer until the user clicks "Show answer" – no JavaScript needed. *@
    <details>
        <summary class="btn btn-light">Show answer</summary>
        <p><span class="highlight">@Model.AnswerText</span></p>
    </details>
</div>

@* asp-route-index adds ?index=... to the link. asp-route-deckId keeps the deck filter. "Previous" is not shown on the first card. *@
<p class="center">
    @if (index > 0)
    {
        <a asp-action="Study" asp-route-deckId="@deckId" asp-route-index="@(index - 1)" class="btn btn-light">← Previous</a>
    }
    <a asp-action="Study" asp-route-deckId="@deckId" asp-route-index="@(index + 1)" class="btn btn-dark">Next →</a>
</p>

<p class="center">
    @if (deckId != null)
    {
        <a asp-controller="FlashcardDeck" asp-action="Details" asp-route-id="@deckId">Back to deck</a>
    }
    else
    {
        <a asp-action="Index">Back to list</a>
    }
</p>
