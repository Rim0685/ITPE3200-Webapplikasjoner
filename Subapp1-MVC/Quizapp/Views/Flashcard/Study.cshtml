@model Quizapp.ViewModels.FlashcardViewModel

@* Shows one flashcard at a time with an expandable answer. *@
@{
    ViewData["Title"] = "Study";

    // Retrieves study position and navigation data from the view model.
    int index = Model.StudyIndex;
    int total = Model.StudyTotal;
    int? deckId = Model.DeckId;
}

@* Adds one because the index starts at zero. *@
<p class="muted center">Card @(index + 1) of @total</p>

<div class="card center">
    <span class="pill">Question</span>
    <h2 class="study-question">@Model.QuestionText</h2>

    @* Hides the answer until the user chooses to reveal it. *@
    <details>
        <summary class="btn btn-light">Show answer</summary>
        <p><span class="highlight">@Model.AnswerText</span></p>
    </details>
</div>

@* Preserves the deck filter when navigating between cards. *@
<p class="center">
    @if (index > 0)
    {
        <a asp-action="Study"
           asp-route-deckId="@deckId"
           asp-route-index="@(index - 1)"
           class="btn btn-light">← Previous</a>
    }

    <a asp-action="Study"
       asp-route-deckId="@deckId"
       asp-route-index="@(index + 1)"
       class="btn btn-dark">Next →</a>
</p>

<p class="center">
    @if (deckId.HasValue)
    {
        <a asp-controller="FlashcardDeck"
           asp-action="Details"
           asp-route-id="@deckId">Back to deck</a>
    }
    else
    {
        <a asp-action="Index">Back to list</a>
    }
</p>