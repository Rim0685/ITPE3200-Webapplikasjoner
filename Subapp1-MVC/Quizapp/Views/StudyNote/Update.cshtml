@* The StudyNote folder contains views for personal study notes. *@
@* This view displays the form for editing an existing study note. *@

@model Quizapp.ViewModels.StudyNoteViewModel

@{
    ViewData["Title"] = "Edit study note";
}

<h1>Edit study note</h1>

<div class="card">
    <form asp-controller="StudyNote" asp-action="Update" method="post">
        @* Identifies the note being edited. Ownership is checked on the server. *@
        <input type="hidden" asp-for="StudyNoteId" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Title"></label>
            <input asp-for="Title" />
            <span asp-validation-for="Title"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Content"></label>
            <textarea asp-for="Content" rows="10"></textarea>
            <span asp-validation-for="Content"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-dark">
            Save changes
        </button>

        <a asp-controller="StudyNote"
           asp-action="Details"
           asp-route-id="@Model.StudyNoteId"
           class="btn btn-light">
            Cancel
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}