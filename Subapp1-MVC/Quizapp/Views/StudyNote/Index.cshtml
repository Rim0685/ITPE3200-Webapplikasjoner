@* The StudyNote folder contains views for personal study notes. *@
@* This view displays search filters and the user's matching notes. *@

@model Quizapp.ViewModels.StudyNoteListViewModel

@{
    ViewData["Title"] = "My study notes";
}

<h1>My study notes</h1>

<a asp-controller="StudyNote"
   asp-action="Create"
   class="btn btn-dark">
    Create study note
</a>

<a asp-controller="Profile"
   asp-action="Index"
   class="btn btn-light">
    Back to profile
</a>

@* Uses GET so search filters are included in the URL. *@
<form asp-controller="StudyNote"
      asp-action="Index"
      method="get"
      class="card">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="SearchText"></label>
        <input asp-for="SearchText"
               placeholder="Search title or content" />
    </div>

    <div class="mb-3">
        <label asp-for="CreatedFrom"></label>
        <input asp-for="CreatedFrom" type="date" />
        <span asp-validation-for="CreatedFrom"
              class="text-danger"></span>
    </div>

    <p>
        <button type="submit" class="btn btn-dark">
            Search
        </button>

        <a asp-controller="StudyNote"
           asp-action="Index"
           class="btn btn-light">
            Clear filters
        </a>
    </p>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <p>Please correct the search filters.</p>
}
else if (Model.Notes.Count == 0)
{
    <p>No study notes found. Create a note or change your filters.</p>
}
else
{
    @foreach (var note in Model.Notes)
    {
        <article class="card">
            <h2>
                <a asp-controller="StudyNote"
                   asp-action="Details"
                   asp-route-id="@note.StudyNoteId">
                    @note.Title
                </a>
            </h2>

            <p>
                Created:
                @note.CreatedAt.ToString("dd.MM.yyyy HH:mm") UTC
            </p>

            <a asp-controller="StudyNote"
               asp-action="Update"
               asp-route-id="@note.StudyNoteId"
               class="btn btn-light">
                Edit
            </a>

            <a asp-controller="StudyNote"
               asp-action="Delete"
               asp-route-id="@note.StudyNoteId"
               class="btn btn-light">
                Delete
            </a>
        </article>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}