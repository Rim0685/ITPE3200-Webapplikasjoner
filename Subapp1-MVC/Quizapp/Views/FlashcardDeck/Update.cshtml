@model Quizapp.ViewModels.FlashcardDeckViewModel
@* Form for editing a deck's name and description. *@
@{
    ViewData["Title"] = "Edit deck";
}

<h1>Edit <span class="highlight">deck</span></h1>

<form asp-action="Update" method="post" class="card">
    <div asp-validation-summary="ModelOnly"></div>

    @* Hidden field that sends the deck's ID, so the controller knows which deck to update. *@
    <input type="hidden" asp-for="FlashcardDeckId" />

    <label asp-for="Name">Name</label>
    <input asp-for="Name" />
    <span asp-validation-for="Name"></span>

    <label asp-for="Description">Description (optional)</label>
    <textarea asp-for="Description" rows="3"></textarea>
    <span asp-validation-for="Description"></span>

    <p>
        <button type="submit" class="btn btn-dark">Save changes</button>
        <a asp-action="Details" asp-route-id="@Model.FlashcardDeckId" class="btn btn-light">Cancel</a>
    </p>
</form>