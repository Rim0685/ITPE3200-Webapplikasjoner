@model IEnumerable<Quizapp.ViewModels.QuizListItemViewModel>

@{
    ViewData["Title"] = "Quizzes";
}

<h1>Choose a <span class="highlight">quiz</span></h1>

<p class="muted">Choose a quiz to test your knowledge.</p>

@if (!Model.Any())
{
    <p class="muted">No quizzes are available right now.</p>
}
else
{
    <div class="grid">
        @foreach (var quiz in Model)
        {
            <div class="card">
                <h3>@quiz.PageTitle</h3>

                @* Displays the description only when the quiz has one. *@
                @if (!string.IsNullOrWhiteSpace(quiz.Description))
                {
                    <p class="muted">@quiz.Description</p>
                }
                <a asp-controller="Quiz"
                   asp-action="Details"
                   asp-route-id="@quiz.QuizId"
                   class="btn btn-dark">
                    View quiz
                </a>
            </div>
        }
    </div>
}
