@model Quizapp.ViewModels.QuizDetailsViewModel

@{
    ViewData["Title"] = Model.PageTitle;
}

<h1>@Model.PageTitle</h1>

<div class="card">
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="muted">@Model.Description</p>
    }

    <p><span class="pill">@Model.QuestionCount questions</span></p>

    <a asp-controller="Quiz"
       asp-action="Play"
       asp-route-id="@Model.QuizId"
       class="btn btn-dark">
        Start quiz
    </a>

    <a asp-controller="Quiz"
       asp-action="Index"
       class="btn btn-light">
        Back to quizzes
    </a>
</div>
