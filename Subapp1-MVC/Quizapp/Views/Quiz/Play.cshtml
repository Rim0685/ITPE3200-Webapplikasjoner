@model Quizapp.ViewModels.QuizPlayViewModel

@{
    ViewData["Title"] = Model.PageTitle;
}

<div class="quiz-play-container">

    <h1 class="quiz-play-title">@Model.PageTitle</h1>

    @if (!Model.Questions.Any())
    {
        <p>Denne quizen har ingen spørsmål ennå</p>
    }
    else
    {
        @foreach (var question in Model.Questions)
        {
            <section class="quiz-question">
                <h2>@question.QuestionText</h2>

                @if (!string.IsNullOrWhiteSpace(question.ImageUrl))
                {
                    <img src="@question.ImageUrl"
                        alt="Bilde til spørsmålet" />
                }

                <partial name="_TextAnswerOptions" model="question" />
                @* Tror ikke vi trenger denne delen fordi bilder ikke skal være svaralternativer. 
                @if (question.IsImageQuestion)
                {
                    <partial name="_ImageAnswerOptions" model="question" />
                }
                else
                {
                    <partial name="_TextAnswerOptions" model="question" />
                }
                *@

            </section>
        }
    }

    <a asp-controller="Quiz"
        asp-action="Details"
        asp-route-id="@Model.QuizId">
        Tilbake til quiz
    </a>

</div>

