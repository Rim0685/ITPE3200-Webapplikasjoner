.option-card {
    display: flex;
    align-items: center;
    position: relative;
    background-color: #ffffff;
    border: 2px solid #d1d5db;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 0.75rem;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
}

.option-card input[type="radio"],
.option-card input[type="checkbox"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
}


.option-card.selected, 
.option-card:has(input:checked) {
    border-color: #2563eb;
    background-color: #eff6ff;
    box-shadow: 0 0 0 2px #2563eb;
}


.option-card:has(input:focus-visible) {
    outline: 3px solid #2563eb;
    outline-offset: 4px;
}


.image-options {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1rem;
}

@media (min-width: 640px) {
    .image-options {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (min-width: 1024px) {
    .image-options {
        grid-template-columns: repeat(4, 1fr);
    }
}

.image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 6px;
    border: 1px solid #e5e7eb;
}

.image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}


.option-card:has(input:checked) .selection-badge {
    display: flex;
    position: absolute;
    top: 8px;
    right: 8px;
    background-color: #2563eb;
    color: #ffffff;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    font-weight: bold;
}


/*  Quiz Play Page
    Styling for siden der brukeren tar en quiz. */

    .quiz-play-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1 rem;
    }

    .quiz-play-title {
        margin-bottom: 2rem;
    }

    .quiz-question {
        background-color: #ffffff;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .quiz-question h2 {
        font-size: 1.25rem;
        margin-bottom: 1rem;
    }

    .quiz-back-link {
        display: inline-block;
        margin-top: 1rem;
        text-decoration: none;
    }